# Configuration de la base de données
DB_NAME=
DB_USER=
DB_PASS=
DB_HOST=
DB_PORT=

# Sécurité
JWT_SECRET=

GOOGLE_TRANSLATE_API_KEY=

OPENWEATHERMAP_API_KEY=

# Configuration Email
EMAIL_PASSWORD=

# ——— Email (Primary: Brevo HTTP API) ———
# Required: Brevo API key (not SMTP password)
BREVO_API_KEY=

# Shared sender identity used by Brevo and as default for SMTP1
EMAIL_SENDER=
EMAIL_SENDER_NAME=

# ——— SMTP Fallback 1 (Gmail or other SMTP) ———
EMAIL_HOST_GMAIL_1=
EMAIL_PORT_GMAIL_1=
EMAIL_PASSWORD_GMAIL_1=
EMAIL_SENDER_GMAIL_1=
EMAIL_SENDER_NAME_GMAIL_1=

# ——— SMTP Fallback 2 (Second Gmail/SMTP account) ———
EMAIL_HOST_GMAIL_2=
EMAIL_PORT_GMAIL_2=
EMAIL_PASSWORD_GMAIL_2=
EMAIL_SENDER_GMAIL_2=
EMAIL_SENDER_NAME_GMAIL_2=

# ——— Discord Webhooks ———
# Existing Discord service webhook (if you already use it elsewhere)
DISCORD_WEBHOOK_URL=

# Dedicated webhook for email failure alerts (required; no defaults in code)
DISCORD_EMAIL_ALERT_WEBHOOK=

ALLOWED_ORIGINS=*

# R2 Storage
R2_ACCESS_KEY_ID=
R2_ACCESS_KEY_SECRET=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# Photos
GOOGLE_DRIVE_CREDENTIALS_JSON=
PHOTOS_DRIVE_ID=
# Optional: poll interval of the Drive changes feed and period of the full reconciliation (Go durations)
# PHOTOS_SYNC_INTERVAL=10m
# PHOTOS_RECONCILE_INTERVAL=168h
# Optional: "off" stops new-album push notifications without touching the photo sync
# PHOTOS_ALBUM_NOTIFICATIONS=on
# Optional: how long an album's photo count must stay unchanged before it is announced (Go duration)
# PHOTOS_NOTIFY_SETTLE=30m

# Photobooth (booth uploads into the Photos drive + permanent share links)
# Booth keys "id:secret,id:secret"; the booth's admin panel takes "id.secret". Generate a secret with:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# PHOTOBOOTH_DEVICE_KEYS=
# Optional: base64 service-account key with Content manager access (default GOOGLE_DRIVE_CREDENTIALS_JSON)
# PHOTOBOOTH_DRIVE_CREDENTIALS_JSON=
# Optional: folder holding the school-year folders (default PHOTOS_DRIVE_ID)
# PHOTOBOOTH_DRIVE_ROOT_ID=
# Optional: share page prefix (default https://transat.dev/photobooth)
# PHOTOBOOTH_SHARE_BASE_URL=

# Photo reports
# Optional: base64 service-account key with Content manager access on the Photos drive, used to delete a photo
# when a report is approved (default PHOTOBOOTH_DRIVE_CREDENTIALS_JSON). Without it, reports can only be rejected.
# PHOTOS_WRITE_CREDENTIALS_JSON=
# Optional: base URL of the admin panel; adds a "view in the admin panel" link to report emails
# ADMIN_PANEL_URL=https://admin.example.com
